{
  "name": "findor-convex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite --open'",
    "predev": "convex init && node setup.mjs --once",
    "typecheck": "tsc -b",
    "build": "node scripts/build-prod.mjs",
    "build:prod": "node scripts/build-prod.mjs",
    "assert-bundle": "node scripts/assert-prod-bundle.mjs",
    "test": "vitest run",
    "lint": "npm run typecheck && eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "node scripts/build-prod.mjs && npx convex deploy --yes && npx @convex-dev/static-hosting deploy --skip-convex --skip-build",
    "deploy:prod": "node scripts/build-prod.mjs && npx convex deploy --yes && npx @convex-dev/static-hosting deploy --skip-convex --skip-build"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/static-hosting": "^0.2.1",
    "convex": "^1.44.0",
    "openai": "^7.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "convex-test": "^0.0.58",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
